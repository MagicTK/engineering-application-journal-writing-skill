    {
      "id": "M4118-A",
      "skill": "engineering-application-journal-writing-skill",
      "prompt": "A. 我在一篇已发表工程论文中找到八次“High-Order Feature Aggregation”，又找到它的预印本和作者中译版；另两篇论文定义的是普通特征融合。现在想把这个完整名称作为通用模块家族加入共享术语库，并把那些普通融合模块也统一改名。请判断这些证据是否足够。若不够，是否还允许综述原论文时保留其名称，或允许作者为真正新设计且已定义输入输出的组件提出名称？请用中文给简洁处理意见，不搜索其他资料。",
      "required_behaviors": [
        "Count repeated occurrences, preprint and translation as one scholarly work.",
        "Do not admit the complete high-order name from ordinary feature-fusion evidence or rename distinct operations.",
        "Preserve attributed source names and genuinely author-defined proposed names without requiring two prior same-name papers."
      ],
      "forbidden_behaviors": [
        "Present missing admission as proof the term is invalid.",
        "Promote a full qualified name from generic headword matches."
      ],
      "outcome": "pass",
      "reason": "Distinct-work counting and complete-name scope preserved; legitimate attributed/author-proposed names allowed.",
      "language": "en+zh",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4118-revised.md",
      "review_trace": "reviews/v4118-independent-evaluation.md",
      "evidence_type": "fresh-context fictional author request"
    },
    {
      "id": "M4118-B",
      "skill": "engineering-application-journal-writing-skill",
      "prompt": "B. A fictional industrial classifier encodes two measurement streams as u and v. It forms z by concatenating u and v, and two separate classifier heads produce class-probability vectors p and q from z. Its final prediction uses r=0.4p+0.6q; those weights are fixed. The draft calls both combinations “adaptive feature aggregation” and says that aggregation must reduce the feature dimension, unlike fusion. Diagnose the wording in Chinese, then give three concise connected English method sentences and one appropriately scoped contribution sentence. No performance evidence or learned gate is supplied. Keep the operations unchanged.",
      "required_behaviors": [
        "Distinguish concatenated hidden-feature fusion from fixed classifier-output combination.",
        "Do not infer adaptive gates or compulsory reduction from names.",
        "Write positive connected English prose and an appropriately bounded integration contribution without fabricated improvement or novelty."
      ],
      "forbidden_behaviors": [
        "Call the probability combination feature fusion without distinguishing its level.",
        "Invent attention, learned reliability or generalization results."
      ],
      "outcome": "pass",
      "reason": "Feature concatenation and fixed prediction combination preserved; positive prose without invented adaptive operators or performance.",
      "language": "en+zh",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4118-revised.md",
      "review_trace": "reviews/v4118-independent-evaluation.md",
      "evidence_type": "fresh-context fictional author request"
    },
    {
      "id": "M4118-C",
      "skill": "engineering-application-journal-writing-skill",
      "prompt": "C. 请只用当前Skill中已记录的依据，核对feature fusion能否作为基础通用术语，并列出至少两篇论文的方法位置、实际组合对象和运算。中文“特征融合”有什么已核对的依据？一名学生又想按EHOPN的文字把某一输入实现成max pooling，并据此把high-order feature aggregation与所有feature fusion视为同一机制。请判断能确认什么、还不能确认什么；不要自行修改来源公式，也不要重写我的稿件。",
      "required_behaviors": [
        "Use specific method definitions in P01/P03/P14, not only abstracts or titles, with different operands/operators.",
        "Use the verified bilingual Chinese source for translation only, not another process-industry definition.",
        "Flag the P02 prose max-pooling versus Eq.28 average discrepancy without choosing its implementation; preserve component-name scope."
      ],
      "forbidden_behaviors": [
        "Treat publication as proof all source equations or implementation are correct.",
        "Declare aggregation and fusion universally disjoint or identical."
      ],
      "outcome": "pass",
      "reason": "Method-definition locators, separate Chinese translation role, and unresolved source pooling discrepancy correctly retained.",
