    {
      "id": "M4205-A",
      "skill": "engineering-application-journal-writing-skill-zh",
      "language": "zh",
      "prompt": "An author has a simulated process benchmark with a deliberately imposed 0.5%-of-reference step at a known time. The measurement noise standard deviation is 2% of that reference. The resulting measured response need not be an ideal step because the closed-loop process responds dynamically. Fault conditions remain at this selected severity; no progressing damage trajectory or plant lifecycle record was generated. The source author calls these incipient-fault scenarios. The study compares measured normal/fault binary decisions. Classify the engineering difficulty and appropriate English/Chinese problem wording, preserving attributed source usage. Can this test alone establish physical early-stage degradation, a slowly growing fault, intermittent faults, noise robustness across levels or shorter detection delay? Is input-variable amplitude the same as learned feature activation magnitude? Do not infer an SNR without the signal/noise definition. Avoid selecting an algorithm. Give a constructive 40-65-word English problem/method-purpose note for an introduction; do not write a defensive limitation list into manuscript prose. No novel method details are available.",
      "required_behaviors": [
        "Distinguish imposed perturbation, measured signature and physical evolution; preserve attributed incipient-fault names without inferring SNR or selecting an algorithm.",
        "Write a positive, scoped 40-65-word problem-purpose note."
      ],
      "forbidden_behaviors": [
        "Infer physical early degradation, inevitable gradual growth, intermittence or cross-noise robustness from a fixed small perturbation.",
        "Equate physical amplitude with learned activation or invent a module."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill-zh"
      ],
      "outcome": "pass",
      "reason": "Separated imposed severity, measured response, physical evolution and feature scale, retaining constructive scoped wording and no inferred SNR or algorithm.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4205-independent.md",
      "review_trace": "reviews/v4205-independent-evaluation.md",
      "evaluation_phase": "one_completed_fresh_context_on_corrected_frozen_source"
    },
    {
      "id": "M4205-B",
      "skill": "engineering-application-journal-writing-skill-zh",
      "language": "zh",
      "prompt": "A separate fictional paper only reports fault-classification F1 on completed windows. A new method has a higher F1; an editor asks to say it provides earlier warnings. There are no alarm timestamps, physical-onset references, safety intervention trials or future-fault targets. A colleague equates the first ten post-onset samples with incipient faults, and calls 10 timestamps at 2-second spacing a 20-second endpoint span. Assess the exact claims and timing, identify only the necessary follow-up if the authors want an early-warning claim, and preserve their valid window-classification finding without requiring new experiments if they keep that scope. Separate an early-after-onset interval, small severity, an issued alarm and prediction of a future event. Check whether the current Skill already has a correct rule, and whether the problem-first route makes the distinction easy to find; do not fabricate a missing rule or propose another Skill file solely for this test.",
      "required_behaviors": [
        "Preserve the valid classification finding while separating severity, early-after-onset timing, issued alarm and future-event prediction.",
        "Use the actual 18-second endpoint span and require timing evidence only for a stronger retained timing claim."
      ],
      "forbidden_behaviors": [
        "Infer earlier warning from window F1, backdate alarms or mandate new experiments for correctly scoped classification.",
        "Treat ten timestamps at two-second spacing as a 20-second endpoint span."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill-zh"
      ],
      "outcome": "pass",
      "reason": "Preserved valid window classification and exact endpoint timing; required alarm/future-event evidence only for stronger retained timing claims and found the existing problem/evidence route.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4205-independent.md",
