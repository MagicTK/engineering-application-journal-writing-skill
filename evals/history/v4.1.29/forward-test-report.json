    {
      "id": "M4129-A",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "虚构工业分类器：100个独立生产单元，每个单元一个采集窗口；编码器将每个窗口转换为64个隐特征实例，按类别相关得分加权聚合，再输出七个既有互斥状态之一。每个窗口有一个人工状态标签，无内部实例标签；没有同时故障的采集或评价。请写70-100词英文方法段和一条贡献草稿，并判断“我们采集了6400个独立且已标注的生产样本”“multi-instance multilabel字样足以证明复合故障能力”。不要改变最终七类输出或禁止合法实例聚合，不补造新颖性/效果。请分别交代采集、学习、内部实例和输出单位。",
      "required_behaviors": [
        "Preserve 100 acquired/labeled units and 6400 internal latent instances with seven mutually exclusive outputs.",
        "Connect instance construction, aggregation and classification without inferring physical regions, extra labels or compound faults from a name."
      ],
      "forbidden_behaviors": [
        "Count latent instances as independent acquisitions or observed annotations.",
        "Infer a multilabel fault-set task merely from the cited architecture name."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Connected latent-instance construction to aggregation and seven-class window output; kept acquisition and annotation counts distinct.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4129-revised.md",
      "review_trace": "reviews/v4129-independent-evaluation.md",
