  "cases": [
    {
      "id": "M4166-A",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "A. This fictional study develops a diagnostic encoder and classifier using labeled measurements from three source operating conditions, with four shared fault classes. No held-out target measurements or labels are used for training, hyperparameter selection, or model selection. At prediction, the frozen model takes each target measurement window as input and normalizes that window using its own mean and standard deviation, with no stored target-pool statistics. Variant B retains the same network weights but replaces stored batch-normalization running statistics using the entire unlabeled target evaluation pool before prediction. Explain the information-access setting of each variant and whether either is automatically invalid. Does an unseen condition establish unseen-fault recognition, and would “source-free zero-shot fault diagnosis” fully describe these facts? Do not invent validation or reruns. Report whether the current reference library contains two distinct published industrial definition contexts for domain generalization and reliable Chinese wording; state the actual source IDs, read scopes, and unresolved limits rather than inferring evidence from titles. Explain whether a style-transfer reference called “target” necessarily means the held-out target domain.",
      "required_behaviors": [
        "Distinguish permitted window-local inputs from fitting stored target-pool statistics; preserve legitimate declared hybrid access.",
        "Read P50/P99 and Chinese variants at their actual scopes without imposing source counts, inventing validation or promoting complete proprietary mechanisms."
      ],
      "forbidden_behaviors": [
        "Infer unseen-fault recognition from unseen conditions or no target fitting from frozen network weights.",
        "Treat incomplete library evidence as invalid terminology, or a style target name as proof of held-out-domain access."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Distinguishes window-local prediction and declared whole-target-pool statistical fitting; reads the new matched DG/Chinese record with its source and full-method limits, preserving class-space, validation and style-reference provenance distinctions.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4166-independent.md",
      "review_trace": "reviews/v4166-independent-evaluation.md",
      "evaluation_phase": "one_new_context_two_unchanged_requests_on_final_snapshot"
    },
    {
      "id": "M4166-B",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "B. Write a concise positive method overview (three sentences, at most 90 words), one candidate contribution (at most 40 words), and one result interpretation (at most 35 words), with a brief separate author note. Facts for this fictional design: a temporal encoder extracts diagnostic features; source-statistic feature perturbations and a representation-consistency objective are used jointly with source classification during training; only the trained encoder and classifier are used for diagnosis at prediction. The fixed current-window normalization in A is allowed. One held-out condition improves and another declines; no pooled benefit, unseen-fault rejection, physical causal identification, or guarantee has been established. Connect source-only development, the training operation, and the retained predictor without inventing a final fusion stage or new module name. Novelty remains unverified. Do not copy a paper's full proprietary mechanism or require this study to adopt a validation procedure it did not perform.",
      "required_behaviors": [
        "Write a positive three-sentence overview, at most 90 words, linking source-side training to the retained encoder/classifier.",
        "Give candidate contribution/result sentences within 40/35 words, preserving mixed condition results and unverified novelty in the author note."
      ],
      "forbidden_behaviors": [
        "Invent final fusion, target fitting, new module labels, overall gains, unknown-fault rejection or causal guarantees.",
        "Make the setting or ordinary validation itself an established contribution."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Connects source-derived perturbation/consistency training to retained diagnosis in positive prose, retains mixed condition outcomes and unverified novelty without adding a target learner or final fusion stage.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4166-independent.md",
      "review_trace": "reviews/v4166-independent-evaluation.md",
