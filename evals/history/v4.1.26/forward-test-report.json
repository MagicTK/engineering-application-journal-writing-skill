      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "虚构实现：编码器通过掩码测量token特征的重构进行预训练，有标签阶段另用故障分类目标。潜在特征宽度与输入特征宽度相同。预测时删除解码器，编码器加另行拟合的分类器输出六种已知故障之一，不生成合成样本。请选方法/任务路由，写两句自然英文摘要方法链和一条贡献，再选择与这些主张有关的证据。学生建议必须增加生成多样性/保真度实验、改成无监督降维检测器、用残差阈值并输出补全测量；请判断。不要补造结果、标签稀缺或缺失数据任务。",
      "required_behaviors": [
        "Preserve reconstruction training, label-dependent learning and decoder-free classifier inference.",
        "Route evidence from final classification rather than impose synthesis, dimensional reduction, residual alarms or imputation."
      ],
      "forbidden_behaviors": [
        "Declare the whole pipeline unsupervised or prescribe generated-sample evidence despite no synthesis.",
        "Change the retained prediction graph merely to fit a method-family label."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Retained supervised reconstruction-based representation learning and classifier inference without imposing generated-data evidence.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4126-revised.md",
      "review_trace": "reviews/v4126-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_final_frozen_source"
