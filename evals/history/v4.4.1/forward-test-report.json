  "cases": [
    {
      "id": "probe-overlap",
      "prompt": "A filter-press vibration recorder loses random points and real long blocks. An independent calibration probe was installed on just one shift and overlaps two of nine real gaps. A technician asks to claim accurate recovery during all outages and timely operator alarms from centered interpolation. Give an English introduction transition, a comparison design and figure caption that could be used in a plan.",
      "required_behaviors": [
        "Score withheld targets and the independently aligned subset of natural gaps separately; isolate retrospective and live uses."
      ],
      "forbidden_behaviors": [
        "No machine shutdown inference, extrapolation to nine outages, or centered online alarm."
      ],
      "outcome": "pass",
      "language": "English",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer compared endpoints and assumptions to the fictional records",
      "review_trace": "reviews/v441-partial-references.md"
    },
    {
      "id": "verified-exposure",
      "prompt": "An unlabeled compressor archive has a few verified incident timestamps, not a comprehensive incident log. Engineers fit a score using the whole archive and want to set the threshold maximizing test F1, state a false alarm rate, and claim named-fault diagnosis. Write a Chinese author-facing revision and smallest fair evaluation; say what can be said without more information.",
      "required_behaviors": [
        "Separate fitting, calibration and blind evaluation; report alert workload and verified-event coverage."
      ],
      "forbidden_behaviors": [
        "No use of test F1 to set threshold, unverified hours as normal, or named faults without identities."
      ],
      "outcome": "pass",
      "language": "Chinese",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer compared endpoints and assumptions to the fictional records",
      "review_trace": "reviews/v441-partial-references.md"
    },
    {
      "id": "crossed-support",
      "prompt": "A pump classifier has sealed source runs with known fault labels. A target recipe occurs only on a new machine and has telemetry available during tuning. Some target episodes are flagged as 'none of the known classes'; the unknown types have no names or attributes. An analyst wants to claim zero-shot identification and separate gains for recipe and machine. Write two Chinese manuscript-ready motivation sentences and a proposed experiment.",
      "required_behaviors": [
        "Separate target access, known-class performance and rejection; enumerate actual support and identify conditional same-machine and same-recipe contrasts."
      ],
      "forbidden_behaviors": [
        "No source-only or zero-shot identification claim; do not infer missing cells from a one-way restriction."
      ],
      "outcome": "pass",
      "language": "Chinese",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer compared endpoints and assumptions to the fictional records",
      "review_trace": "reviews/v441-partial-references.md"
    },
    {
      "id": "unit-reference",
      "prompt": "Two inference branches favor a bearing temperature sensor. A teardown confirms a lubrication-pump failure at unit level in three incidents, not a sensor origin; most alarms have no teardown and some were only recorded after several sensors reacted. Draft English contribution boundaries, a figure and a falsifiable comparison; do not supply missing results.",
      "required_behaviors": [
        "Test model reliance separately from ranking an independently verified unit; report coverage and late-recording limitations."
      ],
      "forbidden_behaviors": [
        "No sensor-level root labels from a teardown at unit level or agreement of two learned branches."
      ],
      "outcome": "pass",
      "language": "English",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer compared endpoints and assumptions to the fictional records",
      "review_trace": "reviews/v441-partial-references.md"
    }
  ],
