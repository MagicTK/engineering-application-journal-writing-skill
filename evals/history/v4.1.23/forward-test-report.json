        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Scientific information flow retained; section roles separated and setup details assigned to Experiments in author notes rather than relocated to Introduction.",
      "evaluator": "Maintainer semantic review; no independent second grader",
