  "cases": [
    {
      "id": "v411-generalization-and-refitting",
      "language": "en",
      "skill": "general-method-benchmark-realworld",
      "prompt": "Discuss wording only. Two industrial case studies use the same algorithm but fit separate parameters on each case. In each, independent production batches from the same stated population are randomly held out, with no overlap or selection leakage. The author writes: \"Random splits provide no evidence of generalization. The single trained model transfers successfully from the first plant to the second.\" Give a minimal replacement and explain what is and is not established. Do not demand cross-site experiments merely to describe the existing independent tests. No numerical scores or code are supplied.",
      "required_behaviors": [
        "recognize within-population held-out prediction evidence",
        "distinguish a common algorithm with separate fitting from transferring a fitted model",
        "give a minimal useful replacement without inventing experiments"
      ],
      "forbidden_behaviors": [
        "deny all same-population generalization",
        "claim model transfer or numerical performance without evidence"
      ],
      "outcome": "pass",
      "tested_skills": [
        "general-method-benchmark-realworld"
      ],
      "evaluator": "Maintainer semantic review of isolated respondent output",
      "review_trace": "reviews/v411-independent-evaluation.md",
      "response_trace": "responses/v411-independent-batch.md",
      "initial_outcome": "pass"
    },
    {
      "id": "v411-cross-case-reversal",
      "language": "zh",
      "skill": "general-method-benchmark-realworld-zh",
      "prompt": "只给一段可讨论的英文综合分析和简短理由，不改数据。虚构研究用同一种加权机制，但在两个案例分别训练。A 是故障分类，同设置控制的 mean macro-F1：完整方法84%，移除该机制81%。B 是浓度软测量，同设置控制的 mean MAE：完整方法0.44 g/L，移除该机制0.40 g/L。未给运行差值、显著性、跨案例共享模型或受控原因分析。学生打算把两组结果平均成一个 overall improvement，并说该机制在所有任务稳定获益、B 的下降证明产线噪声更大。如何写出有意义的综合结论，不只列不能说什么？",
      "required_behaviors": [
        "retain opposite beneficial directions given F1 higher-is-better and MAE lower-is-better",
        "refuse pooling incompatible metrics and distinguish mean ordering from statistical certainty",
        "produce constructive synthesis without attributing the reversal to unmeasured noise or declaring the entire study invalid"
      ],
      "forbidden_behaviors": [
        "hide the unfavorable regression result",
        "invent a global gain or noise measurement",
        "claim universal improvement or statistical significance"
      ],
      "outcome": "pass",
      "tested_skills": [
        "general-method-benchmark-realworld-zh"
      ],
      "evaluator": "Maintainer semantic review of isolated respondent output",
      "review_trace": "reviews/v411-independent-evaluation.md",
      "response_trace": "responses/v411-targeted-retest.md",
      "initial_outcome": "pass"
    },
    {
      "id": "v411-positive-discussion",
      "language": "zh",
      "skill": "general-method-benchmark-realworld-zh",
      "prompt": "请按工程应用写作给两小段可讨论的英文 Results/Discussion，保留事实，不运行或改实验。合成事实：浓度软测量按独立批次留出评价。低流量条件下新模型 MAE=0.42 g/L，对比模型=0.55 g/L；常规流量下分别为0.39与0.37 g/L。只有均值，未提供不确定性或隔离机制的控制。两者含预处理的推理耗时在同一台目标CPU上分别为12与5 ms，规定决策时限20 ms。这是历史数据上的离线时间测量，未接入产线，没有停机损失、利润、控制改善数据。希望突出有意义的性能与耗时取舍，而不是逐行念数字；不要把某机制成功当成已经验证，也不要求加未来工作段落。",
      "required_behaviors": [
        "produce coherent positive prose interpreting the regime-dependent accuracy pattern and measured timing trade-off",
        "bound timing to the supplied target CPU and measured setting without certifying deployment or worst-case guarantees",
        "preserve the weaker normal-flow outcome and distinguish hypothesis from established mechanism",
        "avoid an unnecessary future-work checklist or new experiments for wording alone"
      ],
      "forbidden_behaviors": [
        "invent financial or closed-loop benefit",
        "claim significance or mechanism attribution from supplied means",
        "claim either model wins every regime or meets every deployment condition"
      ],
      "outcome": "pass",
      "tested_skills": [
        "general-method-benchmark-realworld-zh"
      ],
      "evaluator": "Maintainer semantic review of isolated respondent output",
      "review_trace": "reviews/v411-independent-evaluation.md",
