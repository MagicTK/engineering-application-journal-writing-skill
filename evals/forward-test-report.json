  "cases": [
    {
      "id": "M4150-A",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "A: 虚构池化核查：一个样本在单元A的两个已编码节点为[1,3]和[3,5]，单元B只有一个节点[9,12]。实际操作分别求单元内均值，然后按A、B顺序连接；后续线性映射及非线性激活是另一步。请算两个均值及连接输出，并对比“先把单元均值等权平均”和“全部三个节点一起平均”。作者声称“全局平均池化自动得到全厂变量关系，移除了低重要性传感器；因均值对节点顺序不变，之前含位置编码的编码器及整个模型也必然对原始输入顺序不变；后续可学习投影说明池化本身是学习的非均匀节点加权”。请给不超过40词的正向英文操作句，并在中文作者说明中核对这些推论，保留真实的后续映射。还有一条来源文字称max pooling但其式子为均值；不要擅自把来源改成已核一致或用该冲突凑足两篇操作定义。不要将一个来源提出的完整Global-Context Fusion模块名泛化；作者自提且定义清楚的新名称不需要前人同名。查词库是否有已完成的average/mean及global-average pooling专名准入记录，若没有就如实说明，不把已有max pooling或中文译名自动视为其英文操作配对。\n",
      "required_behaviors": [
        "Preserve unit means, ordered concatenation, subsequent mapping, and the different weighting of unequal unit sizes.",
        "Report the actual scoped pooling and translation ledger state; retain the source conflict and complete-name admission limits."
      ],
      "forbidden_behaviors": [
        "Infer physical sensor deletion, new whole-plant relationships, raw-order invariance, or nonuniform node weights from uniform pooling.",
        "Complete operation admission from max-pooling or translation records, or generalize a source-specific full name."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Preserves separate means, ordered concatenation and later learned mapping; distinguishes equal-unit/all-node weighting and reports the now-completed scoped average/GAP and Chinese records without inheriting full source names or unsupported physical/global meanings.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4150-independent.md",
      "review_trace": "reviews/v4150-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_two_unchanged_requests_on_final_snapshot"
    },
    {
      "id": "M4150-B",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "B: 虚构质量预测方法：作者批准新方法名WindowMeanQuality，未批准中文全名。一个带时间位置编码的编码器从每个传感器窗口产生T_s×d特征；对各窗口的实际有效时间位置分别取均值，保留d维及传感器身份，再连接各传感器摘要供质量回归器使用。批处理用零填充到共同长度，但平均时只计真实有效位置；实际不存在跨传感器关系学习器、拓扑先验或图模块。编码器和回归器预测时均保留。给定的两个工业质量数据案例中，相同编码器及训练设置下，比使用展平特征的回归头具有更少的可训练头参数和更低MAE；没有运行时间、在线部署、噪声鲁棒性或跨厂验证。请写100-120词英文摘要和不超过40词的一项贡献候选，连清时间编码→有效位置摘要→传感器连接→质量预测及比较。不要将普通平均本身称为新发明，亦不要否决已批准整体名；摘要用正向描述，零填充、维度和证据限制放作者说明，除非为避免误解确实需要。不要将GAP的global转写成plant-wide关系建模，不把参数变少写成已测加速，也不引入多工序、分类或虚构结果。题设字数仅约束本次合成练习。\n",
      "required_behaviors": [
        "Preserve the approved fictional name, temporal encoding, valid-position means, sensor identity, concatenation and quality-regression path.",
        "Keep the matched two-case head-parameter and MAE comparison without claiming standard averaging as a new invention."
      ],
      "forbidden_behaviors": [
        "Invent graph/topology/stage/classification mechanisms, whole-plant relation learning, sensor deletion or calibrated importance.",
        "Claim measured speed, deployment, noise robustness or cross-plant generalization; create a standard Chinese full name."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Preserves temporal encoding, valid-position averaging, sensor identity, quality regression, the author-approved fictional name and matched two-case head-parameter/MAE comparison without inventing topology, a classifier, new pooling novelty or unmeasured runtime/deployment benefits.",
      "evaluator": "Maintainer semantic review; no independent second grader",
