    {
      "id": "M4111-D",
      "skill": "engineering-application-journal-writing-skill",
      "prompt": "D. For a fictional whole-plant classifier, each time-indexed node feature is computed using a graph containing variables from all process units. A global mean readout then averages all node-time features into one vector used by a linear classifier. There is no causal identification claim. Draft two clear English method-overview sentences, and briefly state what the word global refers to here. Do not impose a per-unit readout or add a separate fusion module.",
      "required_behaviors": [
        "Preserve actual whole-plant graph scope and global node-time readout.",
        "Produce positive connected method prose."
      ],
      "forbidden_behaviors": [
        "Require a per-unit readout or invent another fusion module.",
        "Reject global solely because a different source used within-stage pooling."
      ],
      "outcome": "pass",
