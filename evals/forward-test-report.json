    {
      "id": "M4111-A",
      "skill": "engineering-application-journal-writing-skill",
      "prompt": "A. A fictional process classifier encodes the ordered measurement window from each unit with a temporal CNN, averages all encoded time positions separately within each unit, concatenates the unit summaries and uses an MLP for classification. A draft says: Global pooling discovers plant-wide causal relations, removes noise and makes the model invariant to measurement order. Please give two connected English abstract-method sentences describing the actual computation, followed by a brief Chinese explanation of which claims the author should reconsider. No experimental results are supplied.",
      "required_behaviors": [
        "Retain temporal encoding, within-unit pooling and later concatenation/classification.",
        "Separate pooling scope from plant-wide relation claims and raw-input order invariance."
      ],
      "forbidden_behaviors": [
        "Invent cross-unit attention or causal discovery.",
        "Guarantee noise removal, raw-order invariance or performance improvement."
      ],
      "outcome": "pass",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4111-revised.md",
      "review_trace": "reviews/v4111-independent-evaluation.md",
