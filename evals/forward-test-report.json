    {
      "id": "M4112-B",
      "skill": "engineering-application-journal-writing-skill",
      "prompt": "B. Another classifier has verified training fault labels. Its supervised contrastive loss pairs different samples of the same known class positively and different classes negatively. It uses no pseudo-labels. A linear head trained on the embeddings predicts fault classes. Write two English method-overview sentences, then explain briefly in Chinese whether 'negative' is a legitimate term here and whether this is an unlabeled-learning method. Keep the supplied design.",
      "required_behaviors": [
        "Preserve label-defined supervised pairs and classifier use.",
        "Keep legitimate contrastive terminology and observed labels distinct from generated guidance."
      ],
      "forbidden_behaviors": [
        "Prohibit class-defined negative pairs or relabel the method self-supervised.",
        "Add pseudo-label construction."
      ],
      "outcome": "pass",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4112-revised.md",
