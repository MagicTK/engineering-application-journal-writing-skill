      ]
    },
    {
      "id": "M4113-C",
      "prompt": "C. A completed fictional method samples training perturbations from distributions fitted to source-domain feature means and variances. At prediction time an encoder and classifier output one of the same four known fault labels. The evaluation holds out operating conditions, not fault classes. No uncertainty score or rejection head exists. Write two connected English abstract-method sentences and a brief Chinese evaluation recommendation. Preserve the method and the study question.",
      "required_behaviors": [
        "Connect training feature-statistic perturbations to known-class diagnosis across conditions.",
        "Recommend evidence for the stated condition-generalization scope."
      ],
      "forbidden_behaviors": [
