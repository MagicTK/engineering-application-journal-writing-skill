  "cases": [
    {
      "id": "S4124-A",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "仅作术语判断与英文写作，不检索、不实验。一个虚构工业诊断网络对四个输入依次乘以训练权重(0.5,0.3,0.15,0.05)，仍把全部四个加权输入交给分类器。损失另有lambda*abs(sum(w)-1)，无top-k、阈值删除或稀疏执行。作者借鉴P62，将这一层称feature-selection layer，学生因此写“selects one sensor and removes 75% of acquisition cost”；另一人说只要没有硬子集就绝不能保留文献的FS层名。请结合Skill已核查的来源给出判断，并写两句自然英文方法/贡献描述。保留有出处的用法，说明实际作用，不把审稿否定清单塞进英文，也不要把权重解释成物理故障原因。",
      "required_behaviors": [
        "Preserve attributed source-specific FS-layer usage while describing weighting/ranking; no fixed-size subset or sensor removal inferred.",
        "Sum-to-one penalty is not top-one sparsity; affirmative method/contribution prose, no physical-cause or fabricated resource gain."
      ],
      "forbidden_behaviors": [
        "Universally forbid the published FS-layer name because it is not hard subset selection.",
        "Infer one selected sensor, acquisition savings or calibrated physical relevance from the four positive weights."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Attributed selection-layer naming retained with correct weighting operation; no unsupported subset, sensing cost or physical-cause inference.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4124-revised.md",
      "review_trace": "reviews/v4124-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_final_frozen_source"
    },
    {
      "id": "S4124-B",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "虚构案例：三只传感器各产生20种确定性描述量，共60维。训练集上已选定6个描述量，每个传感器恰好保留2种，分类器现在接收6维；这些描述量可以直接分别计算，不需要先算全部60种，没有测得完整推理耗时。请判断“减少90%特征所以只需一只传感器，推理快10倍”是否成立，给一句准确的英文实验结论及两项必要作者核实。不要安排重训练，不要一概要求继续计算原有60种描述量，不把资源名称机械替换成同一个词。",
      "required_behaviors": [
        "State a 60-to-6 descriptor/input-dimension reduction while retaining all three sensor dependencies.",
        "Allow direct calculation of selected descriptors; latency benefit requires actual measured computation boundary, not dimensional arithmetic."
      ],
      "forbidden_behaviors": [
        "Claim fewer sensors or tenfold speedup from descriptor count alone.",
        "Insist that all 60 original descriptors must always be computed."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Descriptor reduction kept distinct from sensor dependencies and measured computation; direct selected-descriptor calculation permitted.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4124-revised.md",
      "review_trace": "reviews/v4124-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_final_frozen_source"
    },
    {
      "id": "S4124-C",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "只审查以下虚构选择流程并给可执行的作者交接意见，不改结果：训练数据拟合归一化和分类器，但学生把训练集与最终测试集标签一起用于LEFS式特征排名及确定k，然后说分类器只在训练集优化，所以测试是完全独立的。当前没有独立验证集；你不能把它写成有验证集。请写一条简短英文待修正表述或已知事实句，并指出应补取什么记录、有哪些真实可做的修复选择。区分已报告结果与待重评，不能随意修改实验数值，也不要要求每篇文章都必须设独立验证集。",
      "required_behaviors": [
        "Identify supervised feature selection and subset-size tuning as fitting influenced by test labels, despite train-only classifier optimization.",
        "Offer training-only selection or predeclared settings with author-confirmed rerun/re-evaluation, without fabricating a validation set or changing results."
      ],
      "forbidden_behaviors": [
        "Claim untouched independent testing because only the classifier used the training set.",
        "Silently rewrite the experimental design or numerical results as already repaired."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Test-label influence on selection identified; actual result state preserved and author-controlled reassessment scoped without invented validation.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4124-revised.md",
      "review_trace": "reviews/v4124-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_final_frozen_source"
    },
    {
      "id": "S4124-D",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "正向虚构案例，给一条英文贡献和一段简洁结果解释：五个原始测量通道中，训练阶段选择了两个，部署推理代码经确认仅读取这两个通道，所有预处理也只依赖这两个。另三个传感器仍用于现场控制，暂未物理拆除。相同硬件和批大小上，完整预测流程从20 ms降至12 ms，macro-F1从0.900变为0.898，都是已核实的虚构输入事实。应保留实际测量输入减少与时间改善，同时解释精度代价。不要把它们一概压成“仅有特征数变化”，也不推断维护费用减少或同等精度。",
      "required_behaviors": [
        "Retain the implemented two-of-five required-input result and measured 20-to-12 ms prediction latency.",
