    {
      "id": "M4130-A",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "虚构分类器用2000个独立标注基础样本训练编码器与匹配函数；测试任务有4个新类别、每类2个已标注支持样本，另有独立无标签查询供预测。训练episode复用基础样本标签；测试支持集仅用于当前匹配。每个支持窗口另产生24个增强视图。请写70-100词英文方法总览和一条贡献草稿，保留基础学习到支持/查询匹配的联系，不虚构效果/创新。判断“整个模型仅需8个人工标注”“192个增强视图就是192个新标注”“基础训练query有标签就是测试泄漏”，说明当前2-shot主张的准确范围。请独立给出原始当前支持标签及增强视图数量，不把所有核查塞进正文。",
      "required_behaviors": [
        "Connect historical/base fitting to limited-support query prediction and preserve the valid 2-shot task.",
        "Separate 2000 earlier annotations, 8 current support annotations and 192 derived views; reject an unsupported total-cost claim without calling legitimate base learning leakage."
      ],
      "forbidden_behaviors": [
        "Claim the entire model used only 8 observed labels or 192 new labels.",
        "Treat actual base-training query supervision as held-out test-label use or invent performance."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Connected supervised base fitting to valid two-shot query prediction; separated historical labels, eight current support labels and 192 derived views without inventing leakage or performance.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4130-revised.md",
      "review_trace": "reviews/v4130-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_final_frozen_source"
    },
    {
      "id": "M4130-B",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "虚构风机分类任务：4个已有类别各8个独立标注训练窗口，共32个；先按独立运行划分测试集，随后仅从训练窗口生成320个总训练视图，没有预训练、元学习或新类评价。网络从同一窗口提取序列特征与谱图特征，用学习权重融合后分类。作者只主张固定少量标注下分类；学生说“没有episode或未见类，就绝不能写few-shot，必须重做元学习和类别不相交实验”。请给两句自然英文总览、一条贡献草稿和简洁判断；保留合理的低数据设置，不把同源视图叫独立传感器，不由32或320证明通用数量阈值、普遍优越性或实际产线部署。只做写作建议，不执行实验。",
      "required_behaviors": [
        "Preserve fixed low-data classification without mandatory episodic/meta-learning or novel-class redesign.",
        "Connect same-window views and their fusion to classification while keeping 32 annotations distinct from 320 views."
