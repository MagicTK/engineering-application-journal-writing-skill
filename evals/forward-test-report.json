  "cases": [
    {
      "id": "late-sensor-regression",
      "prompt": "Kiln energy demand must be predicted at 14:00; an hourly sensor's 14:00 reading arrives at 14:08; other channels are minute-sampled; an editor suggests zero-fill and linear interpolation on the whole file before splitting. Write two English abstract sentences and a comparison table specifying baselines, evaluation and figure.",
      "required_behaviors": [
        "Keep the 14:08 reading out of a 14:00 prediction; mark methods and figure as proposals; score real demand with matched cutoff."
      ],
      "forbidden_behaviors": [
        "No invented implemented mechanism in an abstract or future-informed interpolation."
      ],
      "outcome": "pass",
      "language": "English",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer checked the final answer against the fictional facts",
      "review_trace": "reviews/v440-problem-method-evidence.md"
    },
    {
      "id": "edge-evidence",
      "prompt": "A machine on an edge board has fewer stored weights and lower server training time than another. Describe the strongest results and design a fair deployment test in Chinese.",
      "required_behaviors": [
        "Separate weight count and server training time from target-board latency, memory and energy."
      ],
      "forbidden_behaviors": [
        "No real-time or edge-efficiency conclusion from parameter count."
      ],
      "outcome": "pass",
      "language": "Chinese",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer checked the final answer against the fictional facts",
      "review_trace": "reviews/v440-problem-method-evidence.md"
    },
    {
      "id": "unknown-label-time",
      "prompt": "A detector rejects unfamiliar assembly faults but test labels have no identity for the rejected types. After a technician supplies some labels next month, the model is updated. Write two introduction transitions, suitable experimental contrasts, and decide how to handle 'root cause found' from a top-ranked vibration channel.",
      "required_behaviors": [
        "Distinguish rejection from naming a class, later updating from initial testing, and inspection leads from verified roots."
      ],
      "forbidden_behaviors": [
        "No class identification from rejection or causal diagnosis from attribution."
      ],
      "outcome": "pass",
      "language": "English",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer checked the final answer against the fictional facts",
      "review_trace": "reviews/v440-problem-method-evidence.md"
    },
    {
      "id": "language-tool-routing",
      "prompt": "A clean-room instrument request may be for trace contamination or pressure stability. A manual is available; a language model selects among two approved tests and a specialist routine supplies a result. Some requests lack the instrument ID. There are expert test choices and held-out final judgments. Write a Chinese introduction bridge, contribution and two experiments (plus a figure); contrast with a time-series model pretrained on numerical sensor histories and adapted with labeled target instrument runs.",
      "required_behaviors": [
        "Separate expert tool-choice agreement from final task judgments and distinguish numerical pretraining; label missing-ID handling as a proposed control."
      ],
      "forbidden_behaviors": [
        "Do not infer a deployed clarification workflow, agent autonomy or zero-shot adaptation."
      ],
      "outcome": "pass",
      "language": "Chinese",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer checked the final answer against the fictional facts",
      "review_trace": "reviews/v440-problem-method-evidence.md"
    },
    {
      "id": "weak-lots-diffusion",
      "prompt": "Fabric lots have only lot-level quality labels, and another collection is entirely unlabeled. An author proposes to generate examples by diffusion, pretrain on unlabeled traces, and use lots from a new recipe as a robustness claim. Give a two-sentence English motivation, a matched comparison design, a meaningful interpretation check and limits. Mention what in the framing would change if no new-recipe samples were available during development.",
      "required_behaviors": [
        "Compare augmentation and unlabeled pretraining separately with matched real lots and target access; probe model reliance."
      ],
      "forbidden_behaviors": [
        "No event labels, causal explanation, fabricated quality evidence or arbitrary recipe robustness."
      ],
      "outcome": "pass",
      "language": "English",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer checked the final answer against the fictional facts",
      "review_trace": "reviews/v440-problem-method-evidence.md"
    },
    {
      "id": "drift-sequential-access",
      "prompt": "A classifier sees a shift in pressure histograms; delayed defect labels arrive monthly and earlier recipe samples cannot be replayed during updates. Give a test design and a one-sentence limited conclusion.",
      "required_behaviors": [
        "Predict before delayed labels, match replay restrictions, score chronological behavior and earlier recipes; separate conditional response from pressure shift."
      ],
      "forbidden_behaviors": [
        "No concept drift inferred solely from input changes; no unmeasured continual-learning gains."
      ],
      "outcome": "pass",
      "language": "English",
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "evaluator": "Fresh responder; maintainer checked the final answer against the fictional facts",
