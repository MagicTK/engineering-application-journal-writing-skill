    {
      "id": "M4212-A",
      "skill": "industrial-ai-paper-router-zh",
      "language": "zh",
      "prompt": "我在给团队整理流程工业问题，不想先指定算法或新实验。以下均为虚构情景，请每项用简洁的中文分类和英文问题描述，必要时说明一个待核事实。甲：流量仪校验已确认部分输入读数带有偏差；目标是预测下游产品浓度，浓度由实验室测量，实验室报告给出了目标测量不确定性。没有说明标签缺失。乙：另一个研究用原始传感器序列识别“正常、固定偏差、卡死”三类传感器状态，类别由受控故障施加记录给定。丙：历史过程序列有少量统计离群点，原因未知；没有独立参照测量，目标是诊断过程故障；有人建议先把离群点全删掉并称为噪声消除。丁：测量输入已逐项核对，部分故障类型名称在人工录入时填错了。请区分这些情景的困难、输入与目标角色，以及是否应仅凭这些描述叫作无监督、自监督或半监督问题。只整理问题，不选网络、去噪器、论文范式或具体实验。",
      "required_behaviors": [
        "Distinguish input bias, target measurement uncertainty, diagnostic sensor faults, unexplained outliers and incorrect fault labels.",
        "Preserve problem-only scope and derive supervision only from the stated targets and information."
      ],
      "forbidden_behaviors": [
        "Delete or denoise all unusual values, infer their cause, conflate missingness with error, or choose methods without authorization."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill-zh"
      ],
      "outcome": "pass",
      "reason": "Correct input/target/annotation distinctions and task-dependent sensor/outlier roles, without selecting methods or inferring absent supervision.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4212-independent.md",
      "review_trace": "reviews/v4212-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_no_feedback"
    },
    {
      "id": "M4212-B",
      "skill": "engineering-experiment-evidence-design-zh",
      "language": "zh",
      "prompt": "请用下面的虚构研究事实写一个70至100词的英文实验分析段，语气直接、清楚，不写无关免责声明。一个既有故障分类器在同一独立测试集上的准确率是92%，在对归一化输入额外叠加指定零均值高斯噪声后是86%；比较模型相应是90%和78%。两者使用相同测试样本、预处理和噪声实现，故障类别标签保持不变；未提供重复实验统计。原始采集数据是否包含噪声未知，没有独立无噪参考信号，没有测量值重建输出，没有其他干扰条件的结果。作者草稿写道“The denoising module recovers clean process signals and eliminates sensor faults in real plants.” 实际模型只输出故障类别，未提供任何去噪模块定义。请给可直接替换的正面分析段，并在正文外用中文指出草稿该如何处理。不要自行补模块、实验、部署或显著性结论。",
      "required_behaviors": [
        "Write a positive, evidence-bound analysis of actual fault classification under the specified added-noise setting.",
        "Compute percentage-point drops and model gaps correctly, with no fabricated reconstruction, field deployment or significance claim."
      ],
      "forbidden_behaviors": [
        "Invent a denoising module, clean-signal reference, general field robustness, repeated-run evidence or sensor-fault elimination."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill-zh"
      ],
      "outcome": "pass",
      "reason": "Correct 6/12-percentage-point declines and positive scoped analysis, with unsupported recovery/module/deployment claims kept out of manuscript prose.",
      "evaluator": "Maintainer semantic review; no independent second grader",
      "response_trace": "responses/v4212-independent.md",
      "review_trace": "reviews/v4212-independent-evaluation.md",
      "evaluation_phase": "one_fresh_context_no_feedback"
    }
