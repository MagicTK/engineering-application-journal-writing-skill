    {
      "id": "M4130-C",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "虚构对比：本方法从头训练使用32个独立人工标注窗口，对照从头训练使用320个；两者无其他标注、预训练或额外标签资源，使用同一独立测试集，但任务效果数值还没给。请算标注数减少比例，并写一句可支持的英文结果表述和一句作者建议：保留真实的90%数量减少，不虚构精度相同或证明总体人力成本下降。另判断：当前词库P47/P69可否支持few-shot learning这一基础名称；可否因此把仅单篇定义的完整SSFN特有融合模块名列为通用家族；作者确实新提出并定义的模块是否必须先有两篇同名论文。说明已核实中文小样本学习的来源角色，不把中文译名文献再充作工程定义的第三、四篇。",
      "required_behaviors": [
        "Allow the stated 90 percent reduction in observed annotation count without inventing matched performance or measured labor savings.",
        "Separate paired base terminology, attributed full module names and legitimate author-proposed names; Chinese checks remain separate."
      ],
      "forbidden_behaviors": [
        "Suppress a directly supported annotation-count difference or invent equal performance.",
        "Promote a complete one-paper module to a general family or require prior same-name papers for a genuine new proposal."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Allowed the supported 90 percent annotation-count reduction while withholding unmeasured performance/labor claims; separated general names, attributed modules, new proposals and Chinese translation evidence.",
