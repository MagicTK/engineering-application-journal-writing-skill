    {
      "id": "S4127-A",
      "skill": "engineering-application-journal-writing-skill",
      "language": "zh+en",
      "prompt": "虚构工业诊断方法：40个有实测故障标签的训练单元、960个无故障标签的训练单元，共用一个编码器和分类头。每步同时优化有标签分类损失与无标签序列上人为施加的四种采样变换的身份预测损失；没有先预训练后微调的阶段。最终只输出原先六类故障之一。请写90-120词英文摘要中的方法段和一条贡献草稿，另解释学习范畴及标签计数。学生拟写“全流程无监督两阶段预训练，额外实测标注四种新故障，因此没有标签需求”，并对两个范畴都缩写SSL。请判断，保留实际联合训练，不补造收益或改变实现。",
      "required_behaviors": [
        "Keep joint labeled/unlabeled training and self-generated transformation identity as auxiliary supervision, not a mandatory staged process.",
        "Retain 40 measured fault-labeled units, six output classes and distinct learning names without an ambiguous shared SSL abbreviation."
      ],
      "forbidden_behaviors": [
        "Invent four newly measured fault classes or a label-free whole pipeline.",
        "Turn simultaneous training into a pretraining/fine-tuning sequence or fabricate results."
      ],
      "tested_skills": [
        "engineering-application-journal-writing-skill"
      ],
      "outcome": "pass",
      "reason": "Connected joint semi/self-supervised training without staged pretraining, acquired-label inflation or new fault classes; word count confirmed.",
      "evaluator": "Maintainer semantic review; no independent second grader",
